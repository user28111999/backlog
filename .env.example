DATABASE_URL="file:./prisma/dev.db"
# Optional SteamGridDB artwork; not needed for manual game entry.
STEAMGRIDDB_API_KEY=""
# Optional IGDB fallback: IGDB authenticates through Twitch OAuth.
# These are NOT used by HowLongToBeat. Leave blank if not using IGDB.
TWITCH_CLIENT_ID=""
TWITCH_CLIENT_SECRET=""
# Crashdummy's hosted HowLongToBeat API; can point to your self-hosted service.
HLTB_API_URL="https://hltbapi.codepotatoes.de"
